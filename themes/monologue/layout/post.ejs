<!DOCTYPE html>
<html lang="zh-CN">
<%- partial('_partial/head') %>
<body>
    <!-- 🧱 积木魔法：引入全站通用顶部导航 -->
    <%- partial('_partial/header') %>

    <main class="article-container">
        <!-- 文章标题与发布时间 -->
        <h1 class="article-title"><%= page.title %></h1>
        <div class="article-meta">发布于：<%= page.date.format('YYYY-MM-DD') %></div>
        
        <!-- 文章完整正文 -->
        <div class="article-content">
            <%- page.content %>
        </div>

        <!-- 🚀 见证奇迹的：同专栏知识点快速切换区！ -->
        <% if (page.categories && page.categories.length > 0) { %>
            <% var currentCat = page.categories.data[0]; %>
            <section class="column-nav-box">
                <h3 style="margin-top: 0; color: #0f172a; font-size: 1.2rem; display: flex; align-items: center; justify-content: space-between;">
                    <span>📚 专栏导航：<%= currentCat.name %></span>
                    <a href="<%- url_for(currentCat.path) %>" style="font-size: 0.85rem; color: #3b82f6; text-decoration: none; font-weight: normal;">查看专栏目录 →</a>
                </h3>
                <p style="color: #64748b; font-size: 0.9rem; margin-bottom: 1.2rem;">本文章属于「<strong><%= currentCat.name %></strong>」专栏，你可以点击下方标题在知识点间自由切换：</p>
                
                <ul style="list-style: none; padding-left: 0; margin: 0;">
                    <!-- 循环输出该专栏下的所有文章 -->
                    <% currentCat.posts.sort('date', 'desc').each(function(item) { %>
                        <li class="nav-item" style="border-left: 4px solid <%= item._id === page._id ? '#3b82f6' : 'transparent' %>;">
                            <% if (item._id === page._id) { %>
                                <!-- 如果是当前正在看的文章，高亮显示！ -->
                                <span style="color: #3b82f6; font-weight: bold; display: block;">
                                    👉 <%= item.title %> <span style="font-size: 0.8rem; background: #e0f2fe; color: #0369a1; padding: 2px 8px; border-radius: 4px; margin-left: 6px;">当前阅读</span>
                                </span>
                            <% } else { %>
                                <!-- 如果是同专栏的其他文章，点击直接丝滑切换！ -->
                                <a href="<%- url_for(item.path) %>" class="nav-link">
                                    📄 <%= item.title %>
                                </a>
                            <% } %>
                        </li>
                    <% }); %>
                </ul>
            </section>
        <% } %>
    </main>

    <!-- 🧱 积木魔法：引入全站通用尾部 -->
    <%- partial('_partial/footer') %>
</body>
</html>